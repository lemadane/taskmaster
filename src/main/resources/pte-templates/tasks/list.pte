|layout layouts/main|

|section title|Taskmaster|/section|

|section content|
<div class="header-section">
    <div>
        <h1 class="header-title">My Tasks</h1>
        <p class="header-subtitle">Manage your daily tasks and schedule</p>
    </div>
    <div>
        <a class="btn-filled" href="/tasks/create">
            <span class="icon" style="margin-right: 0.5rem;"><i class="fa-solid fa-plus"></i></span>
            <span>Create Task</span>
        </a>
    </div>
</div>

<div class="task-grid">
|each task in tasks|
    <div class="material-card" id="task-|task.id|">
        <div>
            <div class="card-top">
                <h3 class="card-title">|task.title|</h3>
                
                |if task.status.value == 'completed'|
                    <span class="m-tag is-completed">
                        <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-circle-check"></i></span>
                        |task.status.displayName|
                    </span>
                |else-if task.status.value == 'in_progress'|
                    <span class="m-tag is-in-progress">
                        <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-spinner fa-spin-pulse"></i></span>
                        |task.status.displayName|
                    </span>
                |else-if task.status.value == 'cancelled'|
                    <span class="m-tag is-cancelled">
                        <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-circle-xmark"></i></span>
                        |task.status.displayName|
                    </span>
                |else-if task.status.value == 'on_hold'|
                    <span class="m-tag is-on-hold">
                        <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-circle-pause"></i></span>
                        |task.status.displayName|
                    </span>
                |else-if task.status.value == 'on_queue'|
                    <span class="m-tag is-on-queue">
                        <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-list-ol"></i></span>
                        |task.status.displayName|
                    </span>
                |else|
                    <span class="m-tag is-pending">
                        <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-clock"></i></span>
                        |task.status.displayName|
                    </span>
                |/if|
            </div>
            <p class="card-desc">|task.description ?? 'No description provided.'|</p>
        </div>
        <div class="card-meta">
            |if task.dueDate|
                <div class="due-date">
                    <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-calendar-days"></i></span>
                    Due: |task.formattedDueDate|
                </div>
            |/if|
            <div class="card-actions">
                <a href="/tasks/|task.id|/edit" class="btn-text">
                    <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-pen-to-square"></i></span> Edit
                </a>
                
                <button 
                    type="button" 
                    class="btn-text has-text-danger"
                    hx-post="/tasks/|task.id|/delete"
                    hx-target="#task-|task.id|"
                    hx-swap="outerHTML"
                    hx-confirm="Are you sure you want to delete this task?"
                >
                    <span class="icon" style="margin-right: 0.25rem;"><i class="fa-solid fa-trash-can"></i></span> Delete
                </button>
            </div>
        </div>
    </div>
|else|
    <div class="empty-state" style="grid-column: 1 / -1;">
        <span class="icon" style="color: #cac4d0; font-size: 3rem;">
            <i class="fa-solid fa-clipboard-list"></i>
        </span>
        <h2 class="empty-title">No tasks found</h2>
        <p class="empty-desc">Get started by creating your very first task!</p>
        <a class="btn-filled" href="/tasks/create">Create Task</a>
    </div>
|/each|
</div>
|/section|
